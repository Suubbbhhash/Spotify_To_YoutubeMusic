# Spotify Developer App Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Only needed if importing your private playlists or Liked Songs
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# YouTube Music Auth File (browser.json or oauth.json)
YTMUSIC_AUTH_FILE=browser.json
